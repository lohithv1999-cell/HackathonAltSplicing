# Run Identity (Name the task as per the user)
run_identity: "My_Run"

# Data Paths
# This specifies the paths to input data files, including the BAM files, metadata CSV, GFF annotation file,
# and reference genome FASTA file.
mixed_bams:
  - "/path/to/01_possorted_genome_bam.bam"
  - "/path/to/02_possorted_genome_bam.bam"
metadata_csv:
  - "/path/to/01_barcodes.csv"
  - "/path/to/02_barcodes.csv"

gff: "/path/to/annotation.gff3"
genome: "/path/to/genome.fa"

# Metadata
sample_id: "My_Sample_ID"

# CSV Column Names
# This section defines the expected column names in the metadata CSV file.
# The user can customize these if their CSV uses different column names for barcodes,
# cell types, or BAM file associations.
csv_columns:
  barcode: "cell_barcode"
  cell_type: "Cluster"
  bam_file: "bam_file"  # Optional column to specify which BAM file each barcode belongs to

# Sequencing Parameters
read_mode: "single"   # Options: "single" or "paired"
fragment_length: 200  # Average length of your RNA fragments
fragment_sd: 20       # Standard deviation of fragment length

# ZW probability threshold
zw_threshold: 0.8

# Optional parameter
# This classifies unassigned (IC:i:0) reads into "scored but below threshold" vs "never pseudo-aligned"
run_ic0_profiling: true  # To run make it as true if not keep it as false

# Split half stability QC (opt-in, heavy: runs assembly + kallisto twice per cell type)
run_splithalf: false

# Library strandedness for StringTie: "fr", "rf", or "" if unstranded.
# Required when the aligner does not emit XS:A: tags on spliced alignments,
# as Cell Ranger does not. Without it StringTie discards spliced reads.
library_type: "fr"
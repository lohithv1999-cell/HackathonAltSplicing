import os
import sys
import csv

configfile: "config.yaml"
RUN_IC0 = config.get("run_ic0_profiling", False)
GFF = config.get("gff", "")
RUN_SPLITHALF = config.get("run_splithalf", False)
OUT_DIR = f"../results/{config['run_identity']}"
os.makedirs("slurm", exist_ok=True)

COL_CELL_TYPE = config.get("csv_columns", {}).get("cell_type", "cell_type")
CSV_PATHS = config.get("metadata_csv", [])
LIB_TYPE = config.get("library_type", "")


# If the metadata CSV path is provided as a string, convert it to a list for consistent processing. If it's empty or not provided, initialize it as an empty list.
if isinstance(CSV_PATHS, str):
    CSV_PATHS = [CSV_PATHS] if CSV_PATHS else []
    
Col_Barcode = config.get("csv_columns", {}).get("barcode", "barcode")
Col_CellType = config.get("csv_columns", {}).get("cell_type", "cell_type")
Col_BAM_File = config.get("csv_columns", {}).get("bam_file", "bam_file")

if CSV_PATHS:
    # Single Cell Mode
    RUN_MODE = "single_cell"
    Target_BAMS = []
    # Read the metadata CSV files to extract unique cell types, which will be used as target BAM file names for downstream processing. Each cell type corresponds to a separate BAM file that will be generated from the mixed BAM files based on the barcode information.
    for csv_file in CSV_PATHS:
        with open(csv_file, "r") as f:
            reader = csv.DictReader(f)
            for row in reader:
                safe_name = row[COL_CELL_TYPE].replace(" ", "_")  # Cell types had spaces in their name, snakemake to convert the spaces into safe underscores
                if safe_name not in Target_BAMS:
                    Target_BAMS.append(safe_name)
else:
    # Bulk Mode
    RUN_MODE = "bulk"
    # Falls back to bulk mode if no metadata CSV is provided.
    Target_BAMS = [config["sample_id"]]

def get_starting_bam(wildcards):
    # Split-half pseudo-samples live in their own directory so they never collide
    # with the real cell-type BAMs from split_mixed_bam. Checked first, because a
    # half is not a cell type in Target_BAMS.
    if "__half" in wildcards.sample_id:
        return OUT_DIR + f"/qc/splithalf/bams/{wildcards.sample_id}.bam"
    if RUN_MODE == "single_cell":
        return f"split_bams/{wildcards.sample_id}.bam"
    else:
        return config.get("bam", f"inputs/{wildcards.sample_id}.bam")

def get_fastq(wildcards):
    if config["read_mode"] == "single":
        return OUT_DIR + f"/fastq/{wildcards.sample_id}_0.fq.gz"
    elif config["read_mode"] == "paired":
        return [
           OUT_DIR + f"/fastq/{wildcards.sample_id}_1.fq.gz",
           OUT_DIR + f"/fastq/{wildcards.sample_id}_2.fq.gz",
        ]
    else:
        sys.exit("Invalid read mode") 

# Generate the appropriate GFF flag for StringTie based on whether an annotation is provided
def stringtie_gff_flag(wildcards):
    return f"-G {GFF}" if GFF else ""

# Generate the appropriate library type flag for StringTie based on the configuration
def stringtie_lib_flag(wildcards):
    return f"--{LIB_TYPE}" if LIB_TYPE else ""

def all_targets():
    targets = [
        OUT_DIR + "/qc/QC_Dashboard.html",
        OUT_DIR + "/qc/summary_statistics.tsv",
    ]
    if RUN_IC0:     
        targets.append(OUT_DIR + "/qc/ic0/ALL_ic0.tsv")
    if RUN_SPLITHALF:
        targets.append(OUT_DIR + "/qc/splithalf/ALL_stability.tsv")
    return targets

rule all:
    input:
        expand(OUT_DIR + "/wp3_add_ic_tag/{sample_id}.bam.bai", sample_id=Target_BAMS),
        all_targets()

rule stringtie:
    input:
        bam=get_starting_bam,
    output:
        gtf=OUT_DIR + "/stringtie/{sample_id}.gtf",
    params:
        gflag=stringtie_gff_flag,
        libflag=stringtie_lib_flag,
    shell:     # used a Linux pipe (|) to force samtools to perfectly coordinate to sort the BAM file in memory right before it gets handed to StringTie.
        r"""samtools sort -@ 8 {input.bam} | stringtie -o {output.gtf} -p 24 {params.gflag} {params.libflag} -"""


rule fastaForTranscripts:
    input:
        gtf=OUT_DIR + "/stringtie/{sample_id}.gtf",
        genome=config["genome"],
    output:
        fa=OUT_DIR + "/stringtie/{sample_id}.fa",
    shell:
        r"""
        gffread -w {output.fa} \
            -g {input.genome} \
            {input.gtf}
        """


rule kallisto_index:
    input:
        fa=OUT_DIR + "/stringtie/{sample_id}.fa",
    output:
        idx=OUT_DIR + "/kallisto/{sample_id}.idx",
    conda:
        "env/kallisto.yml"
    shell:
        r"""
        kallisto index -i {output.idx} {input.fa}
        """


rule get_fastq_from_bam:
    input:
        bam=get_starting_bam,
    output:
        fq0=OUT_DIR + "/fastq/{sample_id}_0.fq.gz",
        fq1=OUT_DIR + "/fastq/{sample_id}_1.fq.gz",
        fq2=OUT_DIR + "/fastq/{sample_id}_2.fq.gz",
    shell:
        r"""
        samtools collate -@ 8 -u --no-PG {input.bam} -O \
        | samtools fastq -@ 8 -0 {output.fq0} -1 {output.fq1} -2 {output.fq2}
        """


rule kallisto_quant:
    input:
        idx=OUT_DIR + "/kallisto/{sample_id}.idx",
        fq=[OUT_DIR + "/fastq/{sample_id}_0.fq.gz"],
    output:
        OUT_DIR + "/kallisto/{sample_id}/pseudoalignments.bam",
    conda:
        "env/kallisto.yml"
    params:
        fq=get_fastq,
        single="--single" if config["read_mode"] == "single" else "",
        fragment_length=config["fragment_length"],
        fragment_sd=config["fragment_sd"],
        outfolder=OUT_DIR + "/kallisto/{sample_id}" # Added to pass cleanly to shell
    shell:
        r"""
        kallisto quant {params.single} -l {params.fragment_length} -s {params.fragment_sd} \
            --threads 24 --pseudobam -o {params.outfolder} -i {input.idx} {params.fq}
        """


rule read_to_transcripts_tsv:
    input:
        bam=OUT_DIR + "/kallisto/{sample_id}/pseudoalignments.bam",
        gtf=OUT_DIR + "/stringtie/{sample_id}.gtf",
    output:
        tsv=OUT_DIR + "/kallisto/{sample_id}/read_transcripts.tsv.gz",
    params:
        threshold=config["zw_threshold"],
    shell:
        r"""
        {workflow.basedir}/scripts/read_to_transcripts_tsv.py \
            --bam {input.bam} \
            --gtf {input.gtf} \
            --prob-assignment {params.threshold} \
        | gzip > {output.tsv}
        """


rule tx_name_to_id:
    input:
        tsv=OUT_DIR + "/kallisto/{sample_id}/read_transcripts.tsv.gz",
    output:
        tsv=OUT_DIR + "/kallisto/{sample_id}/clusters.tsv",
    shell:
        r"""
cat <<'EOF' > {rule}.$$.tmp.R
library(data.table)

tx <- fread('{input.tsv}')
tx[, cluster_id := as.numeric(as.factor(transcript_id))]
fwrite(x=tx[, list(`#read_id`, cluster_id)], file='{output.tsv}', col.names=FALSE, sep='\t')
EOF
Rscript {rule}.$$.tmp.R
rm {rule}.$$.tmp.R
       """

rule add_ic_tag:
    input:
        tsv=OUT_DIR + "/kallisto/{sample_id}/clusters.tsv",
        bam=get_starting_bam
    output:
        bam=OUT_DIR + '/wp3_add_ic_tag/{sample_id}.bam',
    shell:
        r"""
        {workflow.basedir}/../src/python/bam_manipulation/wp3_add_ic_tag.py \
            -i {input.bam} \
            -c {input.tsv} \
            -o {output.bam}
        """

 # samtools index absolutely demands that BAM files be sorted by their genomic coordinates first.
 # We cannot index an unsorted BAM,So, made changes that it sorts the file,
 # overwrites the unsorted one, and then indexes it
rule index_bam:
    input:
        bam=OUT_DIR + "/wp3_add_ic_tag/{sample_id}.bam"
    output:
        bai=OUT_DIR + "/wp3_add_ic_tag/{sample_id}.bam.bai"
    shell:                                        
        """
        samtools sort {input} -o {input}.sorted.bam
        mv {input}.sorted.bam {input}
        samtools index {input}
        """
# Data extraction of tag completeness
rule qc_tag_completeness:
    input:
        bam = OUT_DIR + "/wp3_add_ic_tag/{sample_id}.bam"
    output:
        report = OUT_DIR + "/qc/completeness/{sample_id}_completeness.tsv"
    shell:
        """
        python scripts/qc_tag_completeness.py -i {input.bam} -o {output.report} -s {wildcards.sample_id}
        """

# Sensitivity scanner
rule qc_parameter_sensitivity:
    input:
        bam = OUT_DIR + "/kallisto/{sample_id}/pseudoalignments.bam"
    output:
        report = OUT_DIR + "/qc/sensitivity/{sample_id}_sensitivity.tsv"
    shell:
        """
        python scripts/qc_sensitivity_scanner.py -b {input.bam} -o {output.report} -s {wildcards.sample_id}
        """

# QC dashboard
rule qc_dashboard:
    input:
        comp = expand(OUT_DIR + "/qc/completeness/{sample_id}_completeness.tsv", sample_id=Target_BAMS),
        sens = expand(OUT_DIR + "/qc/sensitivity/{sample_id}_sensitivity.tsv", sample_id=Target_BAMS)
    output:
        html = OUT_DIR + "/qc/QC_Dashboard.html"
    params:
        comp_dir = OUT_DIR + "/qc/completeness",
        sens_dir = OUT_DIR + "/qc/sensitivity",
        ic0_dir = OUT_DIR + "/qc/ic0",
        threshold = config["zw_threshold"]
    shell:
        """
        python scripts/qc_dashboard.py -c {params.comp_dir} -s {params.sens_dir} -i {params.ic0_dir} -t {params.threshold} -o {output.html}
        """

# Per-cell-type profiling: compares the tagged BAM against kallisto's
# pseudoalignment BAM to classify each unassigned read.
rule qc_ic0_profiling:
    input:
        tagged = OUT_DIR + "/wp3_add_ic_tag/{sample_id}.bam",
        pseudo = OUT_DIR + "/kallisto/{sample_id}/pseudoalignments.bam"
    output:
        report = OUT_DIR + "/qc/ic0/{sample_id}_ic0.tsv"
    shell:
        """
        python scripts/qc_ic0_profiling.py \
            -t {input.tagged} \
            -p {input.pseudo} \
            -o {output.report} \
            -s {wildcards.sample_id}
        """

# Collate the per-cell-type profiles into one combined table.
rule qc_ic0_collate:
    input:
        expand(OUT_DIR + "/qc/ic0/{sample_id}_ic0.tsv", sample_id=Target_BAMS)
    output:
        OUT_DIR + "/qc/ic0/ALL_ic0.tsv"
    shell:
        """
        head -1 {input[0]} > {output}
        for f in {input}; do tail -n +2 "$f" >> {output}; done
        """

rule qc_summary:
    input:
        comp = expand(OUT_DIR + "/qc/completeness/{sample_id}_completeness.tsv", sample_id=Target_BAMS),
        sens = expand(OUT_DIR + "/qc/sensitivity/{sample_id}_sensitivity.tsv", sample_id=Target_BAMS)
    output:
        summary = OUT_DIR + "/qc/summary_statistics.tsv"
    params:
        comp_dir = OUT_DIR + "/qc/completeness",
        sens_dir = OUT_DIR + "/qc/sensitivity"
    shell:
        """
        python scripts/qc_summary.py -c {params.comp_dir} -s {params.sens_dir} -o {output.summary}
        """
# Splits each cell-type BAM into two halves by read-name hash and runs
# each half through the existing assembly and pseudoalignment rules as a
# pseudo-sample ({cell}__halfA, {cell}__halfB). The halves are then
# compared: gffcompare matches isoforms on intron chain, since StringTie
# names transcripts arbitrarily per run, and kallisto counts are
# correlated across the matched pairs.

# Diagnostic only. The halves stop after kallisto and never enter the
# tagging chain, so no tagged BAMs are produced from them and nothing is
# recombined. They are deliberately depth-degraded in order to test
# stability, which makes them an instrument rather than an output.

def get_bam_to_split(wildcards):
    if RUN_MODE == "single_cell":
        return f"split_bams/{wildcards.cell}.bam"
    return config.get("bam", f"inputs/{wildcards.cell}.bam")


rule qc_splithalf_split:
    input:
        bam=get_bam_to_split,
    output:
        a=OUT_DIR + "/qc/splithalf/bams/{cell}__halfA.bam",
        b=OUT_DIR + "/qc/splithalf/bams/{cell}__halfB.bam",
    shell:
        r"""
        python scripts/qc_split_bam.py -i {input.bam} -a {output.a} -b {output.b}
        """


rule qc_splithalf_compare:
    input:
        gtf_a=OUT_DIR + "/stringtie/{cell}__halfA.gtf",
        gtf_b=OUT_DIR + "/stringtie/{cell}__halfB.gtf",
        # kallisto_quant declares only the pseudobam, so we depend on that to
        # trigger the build and reach abundance.tsv beside it through params.
        bam_a=OUT_DIR + "/kallisto/{cell}__halfA/pseudoalignments.bam",
        bam_b=OUT_DIR + "/kallisto/{cell}__halfB/pseudoalignments.bam",
    output:
        tsv=OUT_DIR + "/qc/splithalf/{cell}_stability.tsv",
        loci=OUT_DIR + "/qc/splithalf/unstable_loci/{cell}_unstable_loci.tsv",
    params:
        abund_a=OUT_DIR + "/kallisto/{cell}__halfA/abundance.tsv",
        abund_b=OUT_DIR + "/kallisto/{cell}__halfB/abundance.tsv",
        prefix=OUT_DIR + "/qc/splithalf/gffcmp/{cell}",
    shell:
        r"""
        python scripts/qc_splithalf_compare.py \
            --gtf-a {input.gtf_a} --gtf-b {input.gtf_b} \
            --abund-a {params.abund_a} --abund-b {params.abund_b} \
            --gffcompare-prefix {params.prefix} \
            --sample {wildcards.cell} \
            --unstable-loci {output.loci} \
            -o {output.tsv}
        """


rule qc_splithalf_collate:
    input:
        expand(OUT_DIR + "/qc/splithalf/{cell}_stability.tsv", cell=Target_BAMS),
    output:
        OUT_DIR + "/qc/splithalf/ALL_stability.tsv",
    shell:
        r"""
        python scripts/qc_splithalf_collate.py -i {input} -o {output}
        """

# Snakemake will only execute the following rule if Run_Mode is set to "single_cell" in the config.yaml file. 
#This rule takes mixed BAM files and a metadata CSV file,
# and splits the BAM files into separate BAM files for each cell type
#based on the barcode information in the BAM file and the mapping provided in the CSV file.
#The output BAM files are stored in the "split_bams" directory.
if RUN_MODE == "single_cell":
    rule split_mixed_bam:
        input:
            bams = config.get("mixed_bams", []),
            csvs = CSV_PATHS
        output:
            bams = expand("split_bams/{cell_type}.bam", cell_type=Target_BAMS)
        params:
            output_dir = "split_bams",
            col_barcode = Col_Barcode,
            col_celltype = Col_CellType,
            col_bam_file = Col_BAM_File
        script:
            "scripts/split_bam.py"